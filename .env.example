# Telegram bot orqali murojaat formasidan xabar yuborish uchun (10-band)
# Bot yaratish: @BotFather ga /newbot yuboring, tokenni shu yerga qo'ying
TELEGRAM_BOT_TOKEN=

# Xabarlar keladigan chat/kanal ID (o'zingizning shaxsiy chat ID yoki guruh ID)
# ID ni olish: botga /start yozing, so'ng https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# Google Analytics 4 o'lchov ID (11-band)
NEXT_PUBLIC_GA_ID=

# Yandex Metrika hisob raqami
NEXT_PUBLIC_YANDEX_METRIKA_ID=
