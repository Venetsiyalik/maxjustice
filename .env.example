# Telegram bot orqali murojaat formasidan xabar yuborish uchun (10-band)
# Bot yaratish: @BotFather ga /newbot yuboring, tokenni shu yerga qo'ying
TELEGRAM_BOT_TOKEN=

# Xabarlar keladigan chat/kanal ID (o'zingizning shaxsiy chat ID yoki guruh ID)
# ID ni olish: botga /start yozing, so'ng https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# Google Analytics 4 o'lchov ID (11-band)
NEXT_PUBLIC_GA_ID=

# Yandex Metrika hisob raqami
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# ---- Admin panel (/admin) ----
# Login — o'zingiz tanlaysiz
ADMIN_LOGIN=
# `npm run admin:hash` chiqargan qiymatlar (parolning o'zi hech qayerda saqlanmaydi)
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Admin'dan saqlash GitHub'ga commit qiladi. Fine-grained token:
# faqat shu repo, Repository permissions → Contents: Read and write
GITHUB_TOKEN=
# GITHUB_REPO=Venetsiyalik/maxjustice
# GITHUB_BRANCH=master

# Arizalar bazasi — Vercel → Storage → Upstash (Redis) ulanganda avtomatik qo'shiladi
KV_REST_API_URL=
KV_REST_API_TOKEN=
